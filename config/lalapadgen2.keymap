#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER         0
#define SECONDARY_LAYER_LEFT  1
#define SECONDARY_LAYER_RIGHT 2
#define COMMAND_LAYER         3
#define SYSTEM_LAYER          4

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt_hold: mt_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_tap: mt_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_hold_on_other: mt_hold_on_other {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        lt_hold_on_other: lt_hold_on_other {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo SYSTEM_LAYER>, <&mo SYSTEM_LAYER>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_CTRL {
            bindings = <&kp LCTRL>;
            key-positions = <10 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q             &kp W      &kp E         &kp R                                  &kp T                                                       &kp Y     &kp U      &kp I           &kp O       &kp P
&kp A             &kp S      &kp D         &kp F                                  &kp G                                                       &kp H     &kp J      &kp K           &kp L       &kp ENTER
&kp Z             &kp X      &kp C         &kp V                                  &kp B                                                       &kp N     &kp M      &kp COMMA       &kp PERIOD  &kp MINUS
&mo SYSTEM_LAYER  &kp LWIN   &kp LEFT_ALT  &lt_hold_on_other COMMAND_LAYER SPACE  &lt_hold_on_other 2 SPACE  &kp LEFT_SHIFT  &kp RIGHT_SHIFT  &mo 1     &kp RCTRL  &kp LEFT_ARROW  &kp SLASH   &kp RIGHT_ARROW
                  &none      &kp RIGHT     &kp DOWN                               &kp LEFT                   &kp UP          &kp UP           &kp LEFT  &kp DOWN   &kp RIGHT       &none
&mkp LCLK         &mkp RCLK  &mkp MCLK                                                                                                                             &mkp LCLK       &mkp RCLK   &mkp MCLK
&mkp MB4          &mkp MB5   &kp LG(TAB)   &kp LG(D)                              &kp LCTRL                                                   &mkp MB4  &mkp MB5   &kp LG(TAB)     &kp LG(D)   &kp LCTRL
            >;
        };

        SECONDARY_LAYER_LEFT {
            display-name = "secondary_layer";
            bindings = <
&kp EXCLAMATION               &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_1                  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                       &trans  &trans  &trans  &trans  &trans
&mt_hold LEFT_SHIFT NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0                       &trans  &trans  &trans  &trans  &trans
&trans                        &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans                        &trans        &trans                                                                   &trans  &trans  &kp LC(LG(LEFT))
&kp LC(LG(RIGHT))             &trans        &trans        &trans        &trans                       &trans  &trans  &trans  &trans
            >;
        };

        SECONDARY_LAYER_RIGHT {
            bindings = <
&trans          &trans  &trans  &trans  &trans                   &kp CARET         &kp AMPERSAND      &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans          &trans  &trans  &trans  &trans                   &kp BACKSPACE     &kp SINGLE_QUOTE   &kp EQUAL         &kp MINUS             &kp ENTER
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans                   &kp GRAVE         &kp SEMICOLON      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH
&trans          &trans  &trans  &trans  &trans  &trans  &kp DEL  &trans            &trans             &trans            &trans                &trans
                &trans  &trans  &trans  &trans  &trans  &trans   &trans            &trans             &trans            &trans
&trans          &trans  &trans                                                                        &trans            &trans                &trans
&trans          &trans  &trans  &trans  &trans                   &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans            &trans                &trans
            >;
        };

        COMMAND_LAYER {
            display-name = "command_layer";
            bindings = <
&kp LG(Q)                             &kp LG(W)  &trans     &trans     &trans                      &kp ESCAPE     &kp F6         &kp F7          &trans          &kp BACKSPACE
&mt_hold_on_other LEFT_CONTROL LG(A)  &kp LG(S)  &trans     &kp LG(F)  &trans                      &kp BACKSPACE  &trans         &kp LG(K)       &kp LG(L)       &kp TAB
&mt_hold LG(LS(LEFT_SHIFT)) LG(Z)     &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)                   &trans         &kp LG(M)      &trans          &kp UP_ARROW    &trans
&trans                                &trans     &trans     &trans     &trans     &trans  &kp F11  &trans         &kp LC(SPACE)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                                      &trans     &trans     &trans     &trans     &trans  &trans   &trans         &trans         &trans          &trans
&trans                                &trans     &trans                                                                          &trans          &trans          &trans
&trans                                &trans     &trans     &trans     &trans                      &trans         &trans         &trans          &trans          &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
